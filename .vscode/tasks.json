      "windows": {
        "command": "python -m mypy 01-data-reference/python 02-data-declaration/python 03-computation/python 04-comparison/python 05-control-flow/python 06-interface/python 07-input-output/python 08-other-checks/python"
      },
      "problemMatcher": []
    },
    {
      "label": "Static analysis: codespell (both)",
      "type": "shell",
      "command": "codespell --skip '*.md,./target' .",
