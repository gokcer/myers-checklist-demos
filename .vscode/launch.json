{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run this example (Python)",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${fileDirname}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Run this example (Java)",
      "type": "java",
      "request": "launch",
      "mainClass": "${fileBasenameNoExtension}",
      "projectName": "myers-checklist-demos",
      "cwd": "${fileDirname}",
      "console": "integratedTerminal"
    },
    {
      "name": "Run ALL examples (Python + Java)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/run_all.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Run ALL Python examples",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/run_all.py",
      "args": [
        "python"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Run ALL Java examples",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/run_all.py",
      "args": [
        "java"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Run one checklist category...",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/run_all.py",
      "args": [
        "all",
        "${input:category}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "category",
      "type": "pickString",
      "description": "Which checklist category?",
      "options": [
        {
          "label": "01 Data reference",
          "value": "01"
        },
        {
          "label": "02 Data declaration",
          "value": "02"
        },
        {
          "label": "03 Computation",
          "value": "03"
        },
        {
          "label": "04 Comparison",
          "value": "04"
        },
        {
          "label": "05 Control flow",
          "value": "05"
        },
        {
          "label": "06 Interface",
          "value": "06"
        },
        {
          "label": "07 Input / output",
          "value": "07"
        },
        {
          "label": "08 Other checks",
          "value": "08"
        }
      ]
    }
  ]
}
